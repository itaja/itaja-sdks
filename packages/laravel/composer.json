{
  "name": "itaja/itaja-laravel",
  "description": "Itaja for Laravel: declare what you sell in code, push it, receive webhooks as Laravel events.",
  "keywords": ["itaja", "laravel", "payments", "subscriptions", "credits", "licenses", "webhooks"],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/itaja/itaja-sdks/tree/main/packages/laravel",
  "support": {
    "issues": "https://github.com/itaja/itaja-sdks/issues",
    "source": "https://github.com/itaja/itaja-sdks/tree/main/packages/laravel"
  },
  "require": {
    "php": "^8.2",
    "illuminate/cache": "^12.0||^13.0",
    "illuminate/console": "^12.0||^13.0",
    "illuminate/http": "^12.0||^13.0",
    "illuminate/routing": "^12.0||^13.0",
    "illuminate/support": "^12.0||^13.0"
  },
  "require-dev": {
    "opis/json-schema": "^2.3",
    "orchestra/testbench": "^10.0||^11.0",
    "phpunit/phpunit": "^11.5||^12.0||^13.0"
  },
  "autoload": {
    "psr-4": { "Itaja\\Laravel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Itaja\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Itaja\\Laravel\\ItajaServiceProvider"],
      "aliases": { "Itaja": "Itaja\\Laravel\\Facades\\Itaja" }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
