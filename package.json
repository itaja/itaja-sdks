{
  "name": "@itaja/node",
  "version": "0.1.0",
  "description": "Itaja for Node.js servers: declare your catalogue in code, push it, mount one webhook handler, react to typed events.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itaja/itaja-node.git"
  },
  "keywords": [
    "itaja",
    "payments",
    "subscriptions",
    "mobile-money",
    "webhooks",
    "billing"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "itaja": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate": "openapi-typescript spec/openapi.json -o src/generated/openapi.ts",
    "generate:check": "openapi-typescript spec/openapi.json -o src/generated/openapi.ts --check"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
